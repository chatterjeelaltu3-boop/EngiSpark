}

.bPO2ja_Root[data-complete=3D"false"] .bPO2ja_AnsweringHeading { background=
-color: var(--thinking-preview-accent); background-image: linear-gradient(1=
08deg, transparent 0%, transparent 12%, var(--thinking-preview-accent) 29%,=
