ar(--thinking-preview-accent); background: 0px 0px; }
  .bPO2ja_AnsweringHeading, .bPO2ja_AnsweredHeading, .bPO2ja_SupportingDesc=
ription, .bPO2ja_SupportingDescriptionComplete { transition: none; }
