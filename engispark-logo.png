ak) 50%, var(--thinking-preview-highlight) 59%, var(--thinking-preview-acce=
nt) 71%, transparent 88%, transparent 100%); color: rgba(0, 0, 0, 0); opaci=
ty: 1; animation: bPO2ja_HeadingEntrance .34s var(--thinking-preview-enter-=
easing) .33s both, bPO2ja_InitialHeadingShimmer .62s var(--thinking-preview=
-shimmer-easing) .22s forwards, bPO2ja_RepeatingHeadingShimmer 1.93s var(--=
thinking-preview-shimmer-easing) .84s infinite; background-position: 118% 0=
px; background-repeat: no-repeat; background-size: 240% 21px; background-cl=
ip: text; }

.bPO2ja_Root[data-final-answer=3D"true"] .bPO2ja_AnsweringHeading { animati=
on: bPO2ja_RepeatingHeadingShimmer 1.93s var(--thinking-preview-shimmer-eas=
ing) infinite; }

.bPO2ja_AnsweredHeading { color: var(--thinking-preview-accent); opacity: 0=
; transition: opacity .42s var(--thinking-preview-enter-easing); }

.bPO2ja_Root[data-complete=3D"true"] .bPO2ja_AnsweredHeading { opacity: 1; =
}

.bPO2ja_Chevron { color: var(--thinking-preview-accent); }

.bPO2ja_ChevronAnimated { animation: bPO2ja_CompletedChevronEntrance .42s v=
ar(--thinking-preview-enter-easing) both; }

.bPO2ja_SupportingDescription { opacity: 1; max-height: 8em; transition: op=
acity .26s ease-out, max-height .42s var(--thinking-preview-enter-easing); =
overflow: hidden; }

.bPO2ja_SupportingDescriptionLeaving { opacity: 0; }

