tion: opacity .19s ease-out, max-height .42s var(--thinking-preview-enter-e=
asing); }

@keyframes bPO2ja_HeaderEntrance {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes bPO2ja_HeadingEntrance {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes bPO2ja_InitialHeadingShimmer {=20
  0% { background-position: 118% 0px; }
  100% { background-position: -18% 0px; }
}

@keyframes bPO2ja_RepeatingHeadingShimmer {=20
  0% { background-position: 118% 0px; }
  85.5%, 100% { background-position: -18% 0px; }
}

@keyframes bPO2ja_CompletedChevronEntrance {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

