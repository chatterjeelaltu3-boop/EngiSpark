@charset "utf-8";

@keyframes fade-in {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.teleprompter { position: relative; overflow: visible; }

.teleprompter-inner { flex-wrap: wrap; align-content: flex-start; display: =
flex; position: absolute; inset: 0px; }

.teleprompter-word { opacity: 0; white-space: pre; animation: fade-in var(-=
-fade,.5s) cubic-bezier(.37, .55, .86, .88) forwards; }

.gxcrJW_frostedContainer { width: 100%; position: relative; overflow: hidde=
n; }

